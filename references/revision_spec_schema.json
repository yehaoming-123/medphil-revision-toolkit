{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedPhil Revision Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_journal", "source_sha256", "revisions"],
  "properties": {
    "target_journal": {
      "enum": ["mhcp", "jme", "bioethics", "jmp"]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph_index",
          "original_text",
          "revised_text",
          "reason",
          "risk_level",
          "author_confirmation"
        ],
        "properties": {
          "paragraph_index": {"type": "integer", "minimum": 0},
          "original_text": {"type": "string", "minLength": 1},
          "revised_text": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "risk_level": {"enum": ["low", "medium", "high"]},
          "author_confirmation": {"type": "boolean"}
        }
      }
    }
  }
}
